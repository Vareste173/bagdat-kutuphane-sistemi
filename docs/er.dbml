// BAĞDAT — ER şeması v2 (PostgreSQL, 28 tablo)
// CHECK, kısmi (filtreli) unique index ve EXCLUDE kısıtları DBML'de çizilemez;
// Bileşik yabancı anahtarlar dosyanın sonundaki Ref satırlarındadır.

// ---------------- MODÜL 1: Üyelik, personel, sistem ----------------

Table Uyelik_Tipleri {
  uyelik_tipi_id int [pk, increment]
  tip_adi varchar(50) [not null, unique]
  max_kitap_hakki int [not null]            // CHECK > 0
  max_odunc_gun int [not null]              // CHECK > 0
  max_uzatma_sayisi int [not null, default: 1]  // CHECK >= 0 (öğrenci 3, akademisyen 5 gibi)
  max_rezervasyon_saat int [not null, default: 4] // YENİ: masa rezervasyonu süre sınırı, CHECK > 0
  gunluk_ceza_tutari decimal(6,2) [not null, default: 0] // CHECK >= 0
}

Table Subeler {
  sube_id int [pk, increment]
  sube_adi varchar(100) [not null, unique]
  sehir varchar(50)
  adres varchar(255)
  telefon varchar(20)
  acilis_saati time
  kapanis_saati time                        // CHECK kapanis_saati > acilis_saati
  aktif_mi boolean [not null, default: true]
}

Table Uyeler {
  uye_id int [pk, increment]
  uyelik_tipi_id int [not null, ref: > Uyelik_Tipleri.uyelik_tipi_id]
  kayit_sube_id int [ref: > Subeler.sube_id]
  ad varchar(50) [not null]
  soyad varchar(50) [not null]
  eposta varchar(100) [not null, unique]
  telefon varchar(20)
  dogum_tarihi date
  sifre_hash varchar(255) [not null]
  kayit_tarihi date [not null, default: `current_date`]
  uyelik_bitis_tarihi date
  durum varchar(15) [not null, default: 'Aktif'] // CHECK IN ('Aktif','Askıda','Kapalı')
}

Table Kutuphane_Kartlari {
  kart_id int [pk, increment]
  uye_id int [not null, ref: > Uyeler.uye_id]  // artık 1:N; "üye başına tek AKTİF kart" kuralı:
  barkod_no varchar(30) [not null, unique]
  verilme_tarihi date [not null]
  gecerlilik_bitis date
  durum varchar(15) [not null, default: 'Aktif'] // CHECK IN ('Aktif','Kayıp','İptal')

  indexes {
    uye_id [name: 'ux_kart_tek_aktif', note: 'KISMİ UNIQUE: CREATE UNIQUE INDEX ... (uye_id) WHERE durum = \'Aktif\'']
  }
}

Table Roller {
  rol_id int [pk, increment]
  rol_adi varchar(50) [not null, unique]
  yetki_aciklamasi varchar(255)
}

Table Personel {
  personel_id int [pk, increment]
  rol_id int [not null, ref: > Roller.rol_id]
  sube_id int [not null, ref: > Subeler.sube_id]
  ust_personel_id int [ref: > Personel.personel_id] // CHECK personel_id <> ust_personel_id
  ad varchar(50) [not null]
  soyad varchar(50) [not null]
  eposta varchar(100) [not null, unique]
  telefon varchar(20)
  sifre_hash varchar(255) [not null]
  ise_baslama_tarihi date
  durum varchar(15) [not null, default: 'Aktif'] // CHECK IN ('Aktif','İzinli','Ayrıldı')
}

Table Bildirimler {
  bildirim_id int [pk, increment]
  uye_id int [not null, ref: > Uyeler.uye_id]
  tur varchar(30) [not null]                // CHECK IN ('İade Hatırlatma','Rezervasyon Hazır','Ceza','Etkinlik','Ödül','Genel')
  baslik varchar(100)
  mesaj varchar(500) [not null]
  kanal varchar(10)                         // CHECK IN ('E-posta','SMS','Uygulama')
  olusturma_zamani timestamp [not null, default: `now()`]
  okundu_mu boolean [not null, default: false]
}

Table Denetim_Loglari {
  log_id bigint [pk, increment]
  personel_id int [ref: > Personel.personel_id] // sistem işlemiyse boş
  tablo_adi varchar(60) [not null]
  kayit_id int
  islem_turu varchar(10) [not null]         // CHECK IN ('INSERT','UPDATE','DELETE')
  eski_deger text
  yeni_deger text
  islem_zamani timestamp [not null, default: `now()`]
  ip_adresi varchar(45)
  // Yalnızca INSERT: UPDATE/DELETE yetkisi REVOKE edilir + engelleyen tetikleyici
}

// ---------------- MODÜL 2: Katalog ve envanter ----------------

Table Yayinevleri {
  yayinevi_id int [pk, increment]
  yayinevi_adi varchar(150) [not null, unique]
  sehir varchar(50)
  eposta varchar(100)
  web_sitesi varchar(150)
}

Table Kategoriler {
  kategori_id int [pk, increment]
  ust_kategori_id int [ref: > Kategoriler.kategori_id] // CHECK kategori_id <> ust_kategori_id (uzun döngü: tetikleyici)
  kategori_adi varchar(100) [not null]
  dewey_kodu varchar(20)                    // 10 -> 20
  aciklama varchar(255)

  indexes {
    (ust_kategori_id, kategori_adi) [unique]
  }
}

Table Yazarlar {
  yazar_id int [pk, increment]
  ad varchar(50) [not null]
  soyad varchar(50) [not null]
  dogum_yili int
  olum_yili int                             // CHECK olum_yili >= dogum_yili
  uyruk varchar(50)
  biyografi text
}

Table Kitaplar {
  kitap_id int [pk, increment]
  yayinevi_id int [not null, ref: > Yayinevleri.yayinevi_id]
  kategori_id int [not null, ref: > Kategoriler.kategori_id]
  kitap_adi varchar(250) [not null]
  isbn varchar(17) [unique]
  basim_yili int                            // CHECK >= 1450
  baski_no int [not null, default: 1]
  sayfa_sayisi int                          // CHECK > 0
  dil varchar(30) [not null, default: 'Türkçe']
  ozet text
}

Table Kitap_Yazar {
  kitap_id int [not null, ref: > Kitaplar.kitap_id]
  yazar_id int [not null, ref: > Yazarlar.yazar_id]
  yazar_sirasi int [not null, default: 1]   // CHECK > 0
  katki_turu varchar(15) [not null, default: 'Yazar'] // CHECK IN ('Yazar','Çevirmen','Editör')

  indexes {
    (kitap_id, yazar_id) [pk]
    (kitap_id, yazar_sirasi) [unique]       // YENİ: aynı kitapta iki "1. yazar" olamaz
  }
}

Table Raflar {
  raf_id int [pk, increment]
  sube_id int [not null, ref: > Subeler.sube_id]
  raf_kodu varchar(20) [not null]
  bolum_adi varchar(80)
  kat int
  kapasite int                              // CHECK > 0 (bilgi amaçlı)

  indexes {
    (sube_id, raf_kodu) [unique]
    (raf_id, sube_id) [unique]              // YENİ: bileşik FK hedefi
  }
}

Table Kitap_Kopyalari {
  kopya_id int [pk, increment]
  kitap_id int [not null, ref: > Kitaplar.kitap_id]
  sube_id int [not null, ref: > Subeler.sube_id]
  raf_id int                                // boşsa depoda
  barkod varchar(30) [not null, unique]
  durum varchar(15) [not null, default: 'Rafta'] // CHECK IN ('Rafta','Ödünçte','Rezerve','Hasarlı','Kayıp','Bakımda')
  edinme_turu varchar(15) [not null]        // CHECK IN ('Satın Alma','Bağış')
  edinme_tarihi date
  fiyat decimal(8,2)                        // CHECK >= 0; bağışta NULL olabilir

  indexes {
    (kopya_id, kitap_id) [unique]           // YENİ: Kitap_Rezervasyonlari bileşik FK hedefi
  }
}

// ---------------- MODÜL 3: Dolaşım ----------------

Table Odunc_Islemleri {
  odunc_id int [pk, increment]
  uye_id int [not null, ref: > Uyeler.uye_id]
  kopya_id int [not null, ref: > Kitap_Kopyalari.kopya_id]
  veren_personel_id int [not null, ref: > Personel.personel_id]
  teslim_alan_personel_id int [ref: > Personel.personel_id]
  odunc_tarihi date [not null, default: `current_date`]
  son_teslim_tarihi date [not null]         // CHECK >= odunc_tarihi
  teslim_edildigi_tarih date
  uzatma_sayisi int [not null, default: 0]  // CHECK >= 0
  durum varchar(15) [not null, default: 'Aktif'] // CHECK IN ('Aktif','İade Edildi','Gecikmiş','Kayıp')
  // CHECK: (durum = 'İade Edildi') = (teslim_edildigi_tarih IS NOT NULL)

  indexes {
    (odunc_id, kopya_id) [unique]           // YENİ: Hasar_Kayitlari bileşik FK hedefi
    kopya_id [name: 'ux_kopya_tek_acik_odunc', note: 'KISMİ UNIQUE: (kopya_id) WHERE teslim_edildigi_tarih IS NULL']
  }
}

Table Odunc_Uzatmalar {
  uzatma_id int [pk, increment]
  odunc_id int [not null, ref: > Odunc_Islemleri.odunc_id]
  personel_id int [ref: > Personel.personel_id] // üye kendisi yaptıysa boş
  eski_son_tarih date [not null]
  yeni_son_tarih date [not null]            // CHECK > eski_son_tarih
  uzatma_zamani timestamp [not null, default: `now()`]
}

Table Kitap_Rezervasyonlari {
  kitap_rezervasyon_id int [pk, increment]
  uye_id int [not null, ref: > Uyeler.uye_id]
  kitap_id int [not null, ref: > Kitaplar.kitap_id]
  ayrilan_kopya_id int
  talep_zamani timestamp [not null, default: `now()`] // sıra = talep_zamani sırası (sira_no KALDIRILDI)
  durum varchar(15) [not null, default: 'Beklemede'] // CHECK IN ('Beklemede','Hazır','Teslim Alındı','İptal','Süresi Doldu')
  son_alma_zamani timestamp                 // Hazır olduktan sonra alınması gereken son an
  // CHECK: durum='Hazır' ise ayrilan_kopya_id ve son_alma_zamani dolu; 'Beklemede' ise ikisi boş

  indexes {
    (uye_id, kitap_id) [name: 'ux_rezervasyon_tek_aktif', note: 'KISMİ UNIQUE: (uye_id, kitap_id) WHERE durum IN (\'Beklemede\',\'Hazır\')']
  }
}

Table Hasar_Kayitlari {
  hasar_id int [pk, increment]
  kopya_id int [not null, ref: > Kitap_Kopyalari.kopya_id]
  odunc_id int                              // raf kontrolünde bulunduysa boş
  personel_id int [not null, ref: > Personel.personel_id]
  hasar_turu varchar(20) [not null]         // CHECK IN ('Yırtık','Islak','Yazı/Çizim','Eksik Sayfa','Kayıp')
  aciklama varchar(500)
  tespit_tarihi date [not null, default: `current_date`]
  tazminat_tutari decimal(8,2) [not null, default: 0] // CHECK >= 0 — para için TEK KAYNAK

  indexes {
    (hasar_id, odunc_id) [unique]           // YENİ: Cezalar bileşik FK hedefi
  }
}

Table Cezalar {
  ceza_id int [pk, increment]
  odunc_id int [not null, ref: > Odunc_Islemleri.odunc_id]
  hasar_id int
  ceza_turu varchar(15) [not null]          // CHECK IN ('Gecikme','Hasar','Kayıp')
  gecikme_gun int                           // CHECK >= 0
  toplam_tutar decimal(8,2) [not null]      // CHECK >= 0
  olusma_tarihi date [not null, default: `current_date`]
  son_odeme_tarihi date                     // YENİ: CHECK >= olusma_tarihi
  odeme_durumu varchar(15) [not null, default: 'Ödenmedi'] // CHECK IN ('Ödenmedi','Kısmi','Ödendi','Affedildi')
  // CHECK: ceza_turu='Gecikme' ise hasar_id NULL ve gecikme_gun > 0; 'Hasar'/'Kayıp' ise hasar_id NOT NULL

  indexes {
    odunc_id [name: 'ux_tek_gecikme_cezasi', note: 'KISMİ UNIQUE: (odunc_id) WHERE ceza_turu = \'Gecikme\'']
  }
}

Table Ceza_Odemeleri {
  odeme_id int [pk, increment]
  ceza_id int [not null, ref: > Cezalar.ceza_id]
  personel_id int [ref: > Personel.personel_id] // online ödemede boş
  tutar decimal(8,2) [not null]             // CHECK > 0
  odeme_yontemi varchar(15) [not null]      // CHECK IN ('Nakit','Kart','Havale','Online')
  makbuz_no varchar(30) [not null, unique]
  odeme_zamani timestamp [not null, default: `now()`]
}

// ---------------- MODÜL 4: Alanlar ve okuma teşviki ----------------

Table Calisma_Salonlari {
  salon_id int [pk, increment]
  sube_id int [not null, ref: > Subeler.sube_id]
  salon_adi varchar(80) [not null]
  kat int
  kapasite int [not null]                   // CHECK > 0 — etkinlik kapasitesi (etkinlik kontenjanı bunu aşamaz)
  sessiz_mi boolean [not null, default: true]
  grup_calismasi_mi boolean [not null, default: false] // CHECK NOT (sessiz_mi AND grup_calismasi_mi)
  durum varchar(15) [not null, default: 'Açık'] // CHECK IN ('Açık','Bakımda')

  indexes {
    (sube_id, salon_adi) [unique]
    (salon_id, sube_id) [unique]            // YENİ: Etkinlikler bileşik FK hedefi
  }
}

Table Masalar {
  masa_id int [pk, increment]
  salon_id int [not null, ref: > Calisma_Salonlari.salon_id]
  masa_numarasi varchar(10) [not null]
  koltuk_sayisi int [not null, default: 1]  // CHECK > 0
  priz_var_mi boolean [not null, default: false]
  durum varchar(15) [not null, default: 'Aktif'] // CHECK IN ('Aktif','Arızalı')

  indexes {
    (salon_id, masa_numarasi) [unique]
  }
}

Table Masa_Rezervasyonlari {
  rezervasyon_id int [pk, increment]
  uye_id int [not null, ref: > Uyeler.uye_id]
  masa_id int [not null, ref: > Masalar.masa_id]
  baslangic_saati timestamp [not null]
  bitis_saati timestamp [not null]          // CHECK > baslangic_saati
  giris_zamani timestamp
  durum varchar(15) [not null, default: 'Aktif'] // CHECK IN ('Aktif','Giriş Yapıldı','Tamamlandı','İptal','Gelmedi')
  // CHECK: durum='Giriş Yapıldı' ise giris_zamani dolu
  // EXCLUDE (masa_id WITH =, tsrange WITH &&) WHERE (durum IN ('Aktif','Giriş Yapıldı'))
  // EXCLUDE (uye_id WITH =, tsrange WITH &&)  WHERE (durum IN ('Aktif','Giriş Yapıldı'))
}

Table Etkinlikler {
  etkinlik_id int [pk, increment]
  sube_id int [not null, ref: > Subeler.sube_id]
  salon_id int                              // çevrimiçiyse boş
  olusturan_personel_id int [not null, ref: > Personel.personel_id]
  baslik varchar(150) [not null]
  aciklama text
  baslangic_zamani timestamp [not null]
  bitis_zamani timestamp [not null]         // CHECK > baslangic_zamani
  kontenjan int                             // CHECK > 0; boşsa sınırsız; <= salon kapasitesi (tetikleyici)
  durum varchar(15) [not null, default: 'Planlandı'] // CHECK IN ('Planlandı','Tamamlandı','İptal')
  // EXCLUDE (salon_id WITH =, tsrange WITH &&) WHERE (durum = 'Planlandı' AND salon_id IS NOT NULL)
}

Table Etkinlik_Katilimcilari {
  etkinlik_id int [not null, ref: > Etkinlikler.etkinlik_id]
  uye_id int [not null, ref: > Uyeler.uye_id]
  kayit_zamani timestamp [not null, default: `now()`]
  durum varchar(15) [not null, default: 'Kayıtlı'] // YENİ: CHECK IN ('Kayıtlı','İptal')
  katildi_mi boolean [not null, default: false]    // yoklama

  indexes {
    (etkinlik_id, uye_id) [pk]
  }
}

Table Okuma_Istatistikleri {
  istatistik_id int [pk, increment]
  uye_id int [not null, ref: > Uyeler.uye_id]
  yil int [not null]
  ay int [not null]                         // CHECK 1-12
  alinan_kitap_sayisi int [not null, default: 0]     // CHECK >= 0
  zamaninda_iade_sayisi int [not null, default: 0]   // CHECK >= 0
  geciken_iade_sayisi int [not null, default: 0]     // CHECK >= 0
  masa_kullanim_saati decimal(6,2) [not null, default: 0] // CHECK >= 0
  etkinlik_katilim_sayisi int [not null, default: 0] // CHECK >= 0
  puan int [not null, default: 0]           // formül: kitap*10 + zamanında*5 - geciken*3 + masa_saati + etkinlik*5
  // Bilinçli türetilmiş özet tablo (performans); ay sonu yordamı doldurur

  indexes {
    (uye_id, yil, ay) [unique]
  }
}

Table Ayin_Odulleri {
  odul_id int [pk, increment]
  istatistik_id int [not null, ref: > Okuma_Istatistikleri.istatistik_id] // üye bu yoldan bulunur (uye_id KALDIRILDI)
  odul_turu varchar(40) [not null]          // CHECK IN ('Ayın Okuru','En Düzenli Üye','En Aktif Salon Kullanıcısı')
  verilme_tarihi date [not null]
  aciklama varchar(255)

  indexes {
    (istatistik_id, odul_turu) [unique]
  }
}

// ---------------- BİLEŞİK YABANCI ANAHTARLAR ----------------
// Alt-sütunlardan biri NULL ise PostgreSQL kontrolü atlar (MATCH SIMPLE); istenen davranış budur.

Ref: Kitap_Kopyalari.(raf_id, sube_id) > Raflar.(raf_id, sube_id)
Ref: Hasar_Kayitlari.(odunc_id, kopya_id) > Odunc_Islemleri.(odunc_id, kopya_id)
Ref: Cezalar.(hasar_id, odunc_id) > Hasar_Kayitlari.(hasar_id, odunc_id)
Ref: Kitap_Rezervasyonlari.(ayrilan_kopya_id, kitap_id) > Kitap_Kopyalari.(kopya_id, kitap_id)
Ref: Etkinlikler.(salon_id, sube_id) > Calisma_Salonlari.(salon_id, sube_id)

// ---------------- MODÜL GRUPLARI ----------------

TableGroup Uyelik_Personel_Sistem {
  Uyelik_Tipleri
  Uyeler
  Kutuphane_Kartlari
  Subeler
  Roller
  Personel
  Bildirimler
  Denetim_Loglari
}

TableGroup Katalog {
  Yayinevleri
  Kategoriler
  Yazarlar
  Kitaplar
  Kitap_Yazar
  Raflar
  Kitap_Kopyalari
}

TableGroup Dolasim {
  Odunc_Islemleri
  Odunc_Uzatmalar
  Kitap_Rezervasyonlari
  Cezalar
  Ceza_Odemeleri
  Hasar_Kayitlari
}

TableGroup Alanlar_ve_Tesvik {
  Calisma_Salonlari
  Masalar
  Masa_Rezervasyonlari
  Etkinlikler
  Etkinlik_Katilimcilari
  Okuma_Istatistikleri
  Ayin_Odulleri
}

